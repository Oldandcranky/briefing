# Copy to config.yaml in the output dir (BRIEFING_CONFIG, default /data/config.yaml).
# Read at runtime from the mounted volume — no rebuild needed after edits.

feeds:
  Hacker News: https://news.ycombinator.com/rss
  Ars Technica: https://feeds.arstechnica.com/arstechnica/index
  BBC World: https://feeds.bbci.co.uk/news/world/rss.xml

max_per_feed: 8

# Optional. Opens the episode, the email and the page with a local forecast.
# Free, no API key, US only (National Weather Service). Omit to skip weather.
weather:
  lat: 41.8781
  lon: -87.6298
  label: "Chicago, IL"   # omit and the API's own place name is used
  periods: 4             # today, tonight, and the next couple

bullets: 12          # show-note bullets asked of NotebookLM (also used in the email)

# Stories older than this are dropped, and so are undated ones — a missing date is
# how a months-old item sneaks into a "today" briefing. 0 disables the check.
max_age_hours: 48

# Don't re-cover a story aired in the last N days. Identity is the article URL
# (ignoring ?utm= noise), so a follow-up article on a developing story still runs.
# The record lives in aired.jsonl in the output dir. 0 disables the ledger.
ledger_days: 7

# Near-duplicate headlines across feeds are folded together automatically, and the
# stories the most feeds carried are the ones fetched in full below.
full_text:
  count: 10          # articles wanted in full (0 disables; feed summaries are the fallback)
  max_chars: 4000    # per article
  workers: 4         # parallel fetches — keep low on a NAS
  max_attempts: 20   # some pages never yield an article (a Reddit comment thread has no
                     # body to extract), so keep reaching down the ranking to reach `count`
                     # — but stop here. Defaults to count x 2.

# Optional. A listing page behind a session cookie, diffed against a local history
# so only entries you haven't been shown before appear. It goes in the email and on
# the page ONLY — never into the digest, so it stays out of the audio. Omit to skip.
# torrents:
#   url: https://tracker.example/t
#   section: "Staff Picks"     # the table heading to read
#   link_base: https://tracker.example
#   cookie_env: TRACKER_COOKIE # name of the .env var holding the Cookie header
#   history_days: 30           # how long an entry counts as "already seen"
#   max_shown: 15

audio:
  prompts:               # one is picked at random each run
    - "Two hosts, brisk news briefing, no filler. Lead with what changed today."
    - "Two hosts, morning news rundown. Group related stories, skip the chit-chat."
  format: brief          # deep-dive | brief | critique | debate
  length: short          # short | default | long

feed:
  title: Daily Briefing
  base_url: https://example.com/briefing   # public URL where the output dir is served
  keep_episodes: 14      # older episodes are deleted

email:
  to: you@example.com
  from: yourname@gmail.com   # must match the Gmail app-password account (SMTP_PASSWORD)
  smtp_host: smtp.gmail.com
  smtp_port: 587
